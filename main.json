                "securityRules": [
                  {
                    "name": "Allow-SSH",
                    "properties": {
                      "access": "Allow",
                      "direction": "Inbound",
                      "priority": 100,
                      "protocol": "Tcp",
                      "sourceAddressPrefix": "[parameters('mgmtSub')]",
